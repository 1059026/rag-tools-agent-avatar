# 阿里云 DashScope API Key（必须，从 https://dashscope.console.aliyun.com/ 获取）
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx

# LLM 配置（SSE 文本模式 fallback 用）
LLM_PROVIDER=dashscope              # dashscope | lmstudio | openai
LLM_MODEL=qwen-plus                 # qwen-plus | qwen-max | qwen-turbo (dashscope)
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=qwen2.5-coder-14b-instruct-mlx

# Omni 实时多模态模型（WebSocket 实时语音对话，推荐使用）
OMNI_MODEL=qwen3-omni-flash-realtime
OMNI_VOICE=Cherry

# ASR 配置（旧 pipeline 的 SSE 模式使用）
ASR_PROVIDER=dashscope               # dashscope | local_whisper

# TTS 配置（旧 pipeline 的 SSE 模式使用）
TTS_PROVIDER=dashscope               # dashscope | edge_tts
TTS_MODEL=sambert-zhixiao-v1
TTS_VOICE=zhixiao

# 服务端口（需与 frontend/vite.config.ts 代理端口一致）
SERVER_PORT=8081
